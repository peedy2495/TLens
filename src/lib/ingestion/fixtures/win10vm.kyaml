{
  "apiVersion": "kubevirt.io/v1",
  "kind": "VirtualMachineInstance",
  "metadata": {
    "labels": {
      "special": "vmi-windows"
    },
    "name": "vmi-windows"
  },
  "spec": {
    "2": {
      "name": "default"
    },
    "6": {
      "name": "pvcdisk"
    },
    "8": {
      "name": "winiso"
    },
    "domain": {
      "clock": {
        "timer": {
          "hpet": {
            "present": false
          },
          "hyperv": "{}",
          "pit": {
            "tickPolicy": "delay"
          },
          "rtc": {
            "tickPolicy": "catchup"
          }
        },
        "utc": "{}"
      },
      "cpu": {
        "cores": 2
      },
      "devices": {
        "1": {
          "bus": "sata"
        },
        "4": {
          "bus": "sata"
        },
        "6": {
          "masquerade": "{}"
        },
        "disks": {},
        "name": "default",
        "bootOrder": 2,
        "interfaces": {},
        "model": "e1000"
      },
      "features": {
        "acpi": "{}",
        "apic": "{}",
        "hyperv": {
          "relaxed": "{}",
          "spinlocks": {
            "spinlocks": 8191
          },
          "vapic": "{}"
        },
        "smm": "{}"
      },
      "firmware": {
        "bootloader": {
          "efi": {
            "secureBoot": false
          }
        },
        "uuid": "5d307ca9-b3ef-428c-8861-06e72d69f223"
      },
      "resources": {
        "requests": {
          "memory": "4Gi"
        }
      }
    },
    "networks": {},
    "pod": "{}",
    "terminationGracePeriodSeconds": 0,
    "volumes": {},
    "persistentVolumeClaim": {
      "claimName": "iso-win10"
    }
  }
}

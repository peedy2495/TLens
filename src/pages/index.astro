---
import App from '../components/App';
import '../styles.css';
import { pwaInfo } from 'virtual:pwa-info';
const manifestUrl = pwaInfo?.webManifestUrl ?? '/manifest.webmanifest';
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#f7f9fc"/><script is:inline>(function(){try{var raw=localStorage.getItem("dlens-dark");var stored=raw===null?null:JSON.parse(raw);var dark=typeof stored==="boolean"?stored:window.matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.dataset.theme=dark?"dark":"light";var meta=document.querySelector('meta[name="theme-color"]');if(meta)meta.setAttribute("content",dark?"#131820":"#f7f9fc");}catch(e){}})();</script><meta name="description" content="DLens – deine Daten, eine klare Ansicht."/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="default"/><meta name="apple-mobile-web-app-title" content="DLens"/><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/><title>DLens · Data Explorer</title><link rel="icon" href="/favicon.svg"/><link rel="manifest" href={manifestUrl}/></head><body><App client:only="react"/></body></html>
